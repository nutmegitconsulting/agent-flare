{
  // Copy to wrangler.jsonc (gitignored), or let scripts/render-wrangler.mjs generate it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-flare",
  "main": "src/index.ts",
  // No workers.dev route: every request must arrive through Access on your hostname.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "agents.example.com", "custom_domain": true }],
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "HermesSandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-2",
      // One container per active user.
      "max_instances": 10,
      // Debug shell via `wrangler containers ssh`. Needs an ssh-ed25519 key under
      // authorized_keys to work at all; set false to close it entirely.
      "ssh": { "enabled": false }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "Sandbox", "class_name": "HermesSandbox" }]
  },
  "migrations": [
    { "new_sqlite_classes": ["HermesSandbox"], "tag": "v1" }
  ],
  "r2_buckets": [
    { "binding": "BACKUP_BUCKET", "bucket_name": "agent-flare-state" }
  ],
  "kv_namespaces": [
    { "binding": "CREDENTIALS_KV", "id": "YOUR_KV_NAMESPACE_ID" }
  ],
  // Keeps secrets set with `wrangler secret put` across deploys.
  "keep_vars": true,
  "vars": {
    "ACCESS_TEAM_DOMAIN": "your-team.cloudflareaccess.com",
    "ACCESS_AUD_TAG": "your-access-application-aud",
    "ADMIN_EMAILS": "",
    "SLEEP_AFTER": "30m",
    "SNAPSHOT_INTERVAL_MINUTES": "10",
    // With no "Keep awake" and no tap, a container stops after this long even with a tab open.
    "FORGOTTEN_TAB_CAP_HOURS": "12",
    // Worker secrets templates may reference as "$NAME". Comma-separated.
    "TEMPLATE_SECRETS": "",
    // Streams restores instead of loading the whole archive into Durable Object memory.
    "SANDBOX_TRANSPORT": "rpc"
  },
  "triggers": {
    "crons": ["*/5 * * * *", "0 */2 * * *"]
  }
}
