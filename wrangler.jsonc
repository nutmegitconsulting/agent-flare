{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hermes-cloudflare-v6",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "HermesSandbox",
      "image": "ghcr.io/nousresearch/hermes-agent:latest",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "Sandbox", "class_name": "HermesSandbox" },
      { "name": "Agent", "class_name": "HermesAgent" }
    ]
  },
  "migrations": [
    { "new_sqlite_classes": ["HermesSandbox", "HermesAgent"], "tag": "v1" }
  ],
  "r2_buckets": [
    { "binding": "BACKUP_BUCKET", "bucket_name": "hermes-agent-state" }
  ],
  "ai": { "binding": "AI" }
}
