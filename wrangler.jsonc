{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hermes-cloudflare-v6",
  "main": "src/index.ts",
  "workers_dev": false,
  "routes": [{ "pattern": "hermes-agent.hermes-test.app", "custom_domain": true }],
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "HermesSandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 3,
      "ssh": {
        "enabled": true
      },
      "authorized_keys": [
        {
          "name": "redacted",
          "public_key": "ssh-ed25519 REDACTED-PUBLIC-KEY"
        }
      ]
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "Sandbox", "class_name": "HermesSandbox" }
    ]
  },
  "migrations": [
    { "new_sqlite_classes": ["HermesSandbox", "HermesAgent"], "tag": "v1" },
    { "deleted_classes": ["HermesAgent"], "tag": "v2" }
  ],
  "r2_buckets": [
    { "binding": "BACKUP_BUCKET", "bucket_name": "hermes-agent-state" }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "SNAPSHOT_INTERVAL_MINUTES": "5"
  },
  "triggers": {
    "crons": ["*/5 * * * *", "0 */2 * * *"]
  }
}
